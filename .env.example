# Cấu hình Gửi Email Thông Báo Đặt Lịch Máy Ảnh (Gmail SMTP)
# Mặc định email nhận thông báo: trantienky666@gmail.com

# Thông tin tài khoản Gmail SMTP (Bắt buộc để gửi email tự động)
# Điền thông tin vào file .env của dự án:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=trantienky666@gmail.com
SMTP_PASS=
NOTIFICATION_EMAIL=trantienky666@gmail.com

# WEBHOOK_URL (Không bắt buộc / Optional)
# Nếu không cấu hình, hệ thống vẫn gửi email bình thường qua Gmail SMTP.
WEBHOOK_URL=
